[Unit]
Description=Barathrum Box Agent
After=network.target

[Service]
Type=simple
# Root required: iptables, hostapd/dnsmasq service control, GPIO sysfs
# access, binding to port 80.
User=root
WorkingDirectory=/opt/barathrum-box-agent
Environment=BARATHRUM_DATA_DIR=/var/lib/barathrum
ExecStart=/opt/barathrum-box-agent/venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --bind 0.0.0.0:80 \
    --preload \
    'main:app'
# --workers 1: multiple worker processes would each try to own the GPIO
# pins and background countdown loop independently -- this agent is
# deliberately single-process. --threads 4 gives enough concurrency for
# the portal + admin panel + API polling without needing multiple
# workers.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
